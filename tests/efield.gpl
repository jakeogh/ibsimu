reset
set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set key top center samplen 0.65
set size 0.8,0.4

set ytics nomirror
set y2tics nomirror

set out "efield.ps"
set xlabel "x (m)"
set ylabel "Potential (V)"
set y2label "Electric field (V/m)"
plot [-0.0:0.11][-400:1000] "efield.dat" u 1:2 w l title "interp. potential", \
"efield.dat" u 1:3 axes x1y2 w l title "electric field", \
"efield_solid.dat" w l title "solid boundaries"

