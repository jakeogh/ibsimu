set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set key bottom right
set size 0.8,0.4

set out "solver1d_neumann_order.ps"
set xlabel "x (m)"
set ylabel "Potential (V)"
plot [0:0.1] "solver1d_neumann_order1.dat" tit "First order Neumann" w lp 1, \
     "solver1d_neumann_order2.dat" tit "Second order Neumann" w lp 3


