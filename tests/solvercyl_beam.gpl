reset
set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set nokey
set size 0.8,0.4

set out "solvercyl_beam.ps"

set xlabel "r (m)"
set ylabel "Potential (V)"
plot [0:0.06][-200:1200] \
"solvercyl_beam.dat" ind 0 w l ls 1, \
"solvercyl_beam.dat" ind 0 w d ls 3
