reset
set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set key top center samplen 0.65
set size 0.8,0.4

set ytics nomirror
set y2tics nomirror

set out "beam2d.ps"
set xlabel "y (m)"
set ylabel "Potential (V)"
set y2label "Space charge density (10^{-6} C/m^3)"
plot "beam2d.dat" u 1:2 w lp title "Potential", \
"beam2d.dat" u 1:(1e6*$3) axes x1y2 w lp title "Space charge density"

set ytics mirror
set out "beam2d_map.ps"
set xlabel "y (m)"
set ylabel "Space charge density (10^{-6} C/m^3)"
unset y2label
set pm3d map
splot "beam2d_map.dat" u 1:2:(1e6*$4) title "Space charge density"

