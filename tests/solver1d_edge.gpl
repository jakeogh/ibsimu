set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set nokey
set size 0.8,0.4

set out "solver1d_edge.ps"
f(x) = (x < 0.013) ? (0.0) : ((x > 0.087) ? (10.0) : (10*(x-0.013)/0.074))
set xlabel "x (m)"
set ylabel "Potential (V)"
plot f(x), "solver1d_edge.dat" w p 3
