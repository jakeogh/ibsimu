reset
set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set nokey
set size 0.8,0.4

set out "solver2d_cylindrical_beam.ps"

f(x) = (x < 0.05) ? ( (x < 0.01) ? (-2823522.6669*x*x + 1191.20915203) \
: (-564.704533379*log(x) - 1691.70359567) ) : 0.0
set xlabel "r (m)"
set ylabel "Potential (V)"
plot [0:0.06] f(x), "solver2d_cylindrical_beam.dat" u 3:4 w d 3
