reset
set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set key bottom center samplen 0.65
set size 0.8,0.4

set ytics nomirror
set y2tics nomirror

set out "efield_extrpl_mirror.ps"
set xlabel "x (m)"
set ylabel "Potential (V)"
set y2label "Electric field (V/m)"
plot "efield_extrpl.dat" ind 0 u 1:2 w l title "interp. potential", \
"efield_extrpl.dat" ind 0 u 1:3 axes x1y2 w l title "electric field"

set out "efield_extrpl_zero.ps"
plot "efield_extrpl.dat" ind 1 u 1:2 w l title "interp. potential", \
"efield_extrpl.dat" ind 1 u 1:3 axes x1y2 w l title "electric field"

set out "efield_extrpl_extrapolate.ps"
plot "efield_extrpl.dat" ind 2 u 1:2 w l title "interp. potential", \
"efield_extrpl.dat" ind 2 u 1:3 axes x1y2 w l title "electric field"

