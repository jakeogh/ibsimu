set sample 1000
set encoding iso_8859_1
set term post port enh solid color "Times-Roman" 12
set nokey
set size 0.8,0.4

set out "solver1d_solid_neumann_conflict.ps"
set xlabel "x (m)"
set ylabel "Potential (V)"
plot [0:0.1] \
"solver1d_solid_neumann_conflict1.dat" w lp 1, \
"solver1d_solid_neumann_conflict2.dat" w lp 3


